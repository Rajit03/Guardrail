# Guardrail Environment Variables Example

# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=guardrail
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Backend Database URL for SQLAlchemy (psycopg 3 driver)
DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/guardrail

# JWT Authentication
# IMPORTANT: Generate a strong secret key in production e.g. using `openssl rand -hex 32`
JWT_SECRET=change_this_in_production_super_secret_key_12345
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS Configuration
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Ollama AI Security Copilot
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b
OLLAMA_TIMEOUT_SECONDS=60
MAX_CONTEXT_FINDINGS=10
MAX_HISTORY_MESSAGES=10
COPILOT_RATE_LIMIT_PER_HOUR=30

